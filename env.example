# Names only. Values go in .env.local (never committed) or the host's environment settings.

# Luma: one calendar's API key. With it, each city shows its state from its Luma event (Open, Filling up, Waiting
# list, Sold out); without it, every city shows Open.
LUMA_API_KEY=

# The site's own address, for the share image, the canonical link, robots and the sitemap. Defaults to the host's.
SITE_URL=

# The base path the site is served under (/builderday on supabase.com); empty on the dev server. Read at build time.
NEXT_PUBLIC_BASE_PATH=
