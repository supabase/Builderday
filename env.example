# Names only. Values go in .env.local (never committed) or the host's environment settings.

# The backend. When NEXT_PUBLIC_SUPABASE_URL is unset the site draws its seeded world and keeps sign-in in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the personal links and the editor install lines. Any long random string; changing it ends every link.
HACKDAY_KEY_SECRET=

# The first super admins, comma separated. They get the role when they first sign in to the desk.
SUPER_ADMINS=

# Email. Without RESEND_API_KEY every email stays in the outbox (the desk shows it, the dev server prints it).
RESEND_API_KEY=
# The sending address, on a domain verified in Resend, for example Supabase Builder Day <hello@mail.example.com>
MAIL_FROM=
# Held unless set to off: with the hold on, place emails (sent to the whole list by Luma's webhook or the desk) wait in
# the outbox. Emails a person asks for (sign-in codes, their link again, claims, roles) still send.
# Lift it only when the site is ready; then the desk's "send unsent links" sends the places whose link never went out.
MAIL_HOLD=
# Place emails while the hold is on, for these only: addresses or @domains, comma separated.
MAIL_ALLOW=

# The site's own address, for links in emails and the editor install line. Defaults to the request's host.
SITE_URL=

# Reads GitHub for the repository checks (5,000 requests an hour with a token, 60 without).
GITHUB_TOKEN=

# The editor server's public base, without a key: the Supabase function in front of it
# (https://<project>.supabase.co/functions/v1/mcp), or the site's own /api/mcp. Signed-in builders see their own install
# line (this base, a slash, their key). Left empty, the base is the site's own /api/mcp whenever the backend is on.
# Read at build time.
NEXT_PUBLIC_HACKDAY_MCP_URL=
# The site's address as the Supabase function reaches it (a function secret, set with supabase secrets set).
HACKDAY_SITE_URL=

# Local stack only (ignored unless the Supabase address is on this machine): 1 reads every GitHub repository as public and made now (tests, the load run).
HACKDAY_FAKE_GITHUB=

# Development only: 1 prints each outbox email in the dev server's log and lets the desk read sign-in codes.
HACKDAY_DEV_MAIL=

# Development only: the local stack's mail catcher (Mailpit), for example http://127.0.0.1:55424. Each outbox email is also delivered there. Ignored unless it is on this machine.
MAIL_CATCHER_URL=

# Luma (needs Luma Plus): one calendar's API key. With it, the desk's Guests screen syncs a city's approved guests from its Luma event (set under Cities), and the room code checks an unknown email against that event. Without it, the CSV import and the room code carry everything.
LUMA_API_KEY=
# Tests only: a stand-in Luma on this machine (http://127.0.0.1:<port>/v1). Any other address is ignored.
LUMA_API_URL=
